{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["firefox-webext-browser", "node"]
  },
  "include": ["src", "test", "build.mjs"]
}
