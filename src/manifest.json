{
  "manifest_version": 2,
  "name": "Omni Viewer",
  "version": "0.2.0",
  "description": "Abre .docx, .pptx e .xlsx direto no navegador, como o leitor de PDF.",
  "browser_specific_settings": {
    "gecko": {
      "id": "omni-viewer@sh-lucas",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["webRequest", "webRequestBlocking", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_title": "Abrir arquivo no Omni Viewer" }
}
